<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <ApplicationIcon>app.ico</ApplicationIcon>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <Company>App Dev Space</Company>
        <Product>Mouse Clicker UI</Product>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
        <!-- Only version/company info is wanted from assembly info generation; the platform
             attributes would trigger CA1416 warnings in the (non-Windows TFM) test project. -->
        <GenerateSupportedOSPlatformAttribute>false</GenerateSupportedOSPlatformAttribute>
        <GenerateTargetPlatformAttribute>false</GenerateTargetPlatformAttribute>
        
        <!-- Publishing Configuration -->
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <PublishReadyToRun>true</PublishReadyToRun>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <Resource Include="app.ico" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="MouseClickerUI.Tests/**" />
        <EmbeddedResource Remove="MouseClickerUI.Tests/**" />
        <None Remove="MouseClickerUI.Tests/**" />
    </ItemGroup>

</Project>
